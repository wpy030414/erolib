{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for EroLib",
  "windows": ["main", "pixiv-login", "ehentai-login", "nicecat-api-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-close",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPLOCALDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    },
    "core:path:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://gxxa.fun/**" },
        { "url": "https://ncmm.cc/**" }
      ]
    }
  ]
}
